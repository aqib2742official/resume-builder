# ── MongoDB Atlas (free M0 cluster) ─────────────────────────────────────────
# Replace with your own connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume-builder?retryWrites=true&w=majority

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a random 32-char secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Groq AI (already in use) ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
